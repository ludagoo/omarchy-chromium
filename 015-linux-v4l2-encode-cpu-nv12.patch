   }
 
-  auto platform_layout = GetPlatformVideoFrameLayout(
-      output_format, output_size,
-      gfx::BufferUsage::VEA_READ_CAMERA_AND_CPU_READ_WRITE);
+  std::optional<VideoFrameLayout> platform_layout;
+  VideoFrame::StorageType output_storage_type =
+      VideoFrame::STORAGE_MAPPABLE_SHARED_IMAGE;
+#if BUILDFLAG(IS_LINUX) && !BUILDFLAG(IS_CHROMEOS)
+  if (!native_input_mode_) {
+    // Mesa GBM rejects NV12. LibYUV converts into a CPU frame and the
+    // encoder imports that frame as USERPTR.
+    auto cpu_frame = VideoFrame::CreateFrame(
+        output_format, output_size, output_visible_rect,
+        output_visible_rect.size(), base::TimeDelta());
+    if (!cpu_frame) {
+      LOG(ERROR) << "Failed to allocate a CPU image-processor frame";
+      return false;
+    }
+    platform_layout = cpu_frame->layout();
+    output_storage_type = VideoFrame::STORAGE_OWNED_MEMORY;
+  }
+#endif
+  if (!platform_layout) {
+    platform_layout = GetPlatformVideoFrameLayout(
+        output_format, output_size,
+        gfx::BufferUsage::VEA_READ_CAMERA_AND_CPU_READ_WRITE);
+  }
   if (!platform_layout) {
     LOG(ERROR) << "Failed to get Platform VideoFrameLayout";
     return false;
@@ -523,7 +544,7 @@
   }
   auto output_config =
       VideoFrameLayoutToPortConfig(*output_layout, output_visible_rect,
-                                   VideoFrame::STORAGE_MAPPABLE_SHARED_IMAGE);
