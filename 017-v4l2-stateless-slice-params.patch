 struct V4L2VideoDecoderDelegateH264Private {
   struct v4l2_ctrl_h264_decode_params v4l2_decode_param;
+  struct v4l2_ctrl_h264_slice_params slice_params = {};
+  struct v4l2_ctrl_h264_pred_weights pred_weights = {};
+  // Pictures in the same order as v4l2_decode_param.dpb[]. Slice ref lists
+  // name these slots, not timestamps.
+  std::vector<H264Picture*> dpb_pics;
+  bool pred_weights_required = false;
+  bool have_slice = false;
+  int slice_count = 0;
+  // ChromeOS stateless decoders are frame-based and parse Annex-B themselves.
+  // Mainline decoders (AVD, hantro, rkvdec, cedrus) advertise the real mode.
+  int32_t decode_mode = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED;
+  int32_t start_code = V4L2_STATELESS_H264_START_CODE_ANNEX_B;
+  bool controls_queried = false;
 };
 
+void QueryH264StatelessControls(V4L2Device* device,
+                                V4L2VideoDecoderDelegateH264Private* priv) {
+  if (priv->controls_queried) {
+    return;
+  }
+  priv->controls_queried = true;
+
+  struct v4l2_queryctrl query = {};
+  query.id = V4L2_CID_STATELESS_H264_DECODE_MODE;
+  if (device->Ioctl(VIDIOC_QUERYCTRL, &query) == 0 &&
+      !(query.flags & V4L2_CTRL_FLAG_DISABLED)) {
+    priv->decode_mode = query.default_value;
+  }
+  query = {};
+  query.id = V4L2_CID_STATELESS_H264_START_CODE;
+  if (device->Ioctl(VIDIOC_QUERYCTRL, &query) == 0 &&
+      !(query.flags & V4L2_CTRL_FLAG_DISABLED)) {
+    priv->start_code = query.default_value;
+  }
+  VLOGF(1) << "H.264 stateless decode_mode=" << priv->decode_mode
+           << " start_code=" << priv->start_code;
+}
+
+int FindH264DpbIndex(const std::vector<H264Picture*>& dpb,
+                   const H264Picture* pic) {
+  if (!pic) {
+    return -1;
+  }
+  for (size_t i = 0; i < dpb.size(); ++i) {
+    if (dpb[i] == pic) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+bool FillH264RefList(const std::vector<H264Picture*>& dpb,
+                     const H264Picture::Vector& refs,
+                     struct v4l2_h264_reference* out,
+                     int count) {
+  if (count < 0 || count > V4L2_H264_REF_LIST_LEN) {
+    return false;
+  }
+  for (int i = 0; i < count; ++i) {
+    if (i >= static_cast<int>(refs.size()) || !refs[i]) {
+      return false;
+    }
+    const int index = FindH264DpbIndex(dpb, refs[i].get());
+    if (index < 0) {
+      return false;
+    }
+    out[i].index = static_cast<__u8>(index);
+    out[i].fields = V4L2_H264_FRAME_REF;
+  }
+  return true;
+}
