+  slice->redundant_pic_cnt = static_cast<__u8>(slice_hdr->redundant_pic_cnt);
+  slice->cabac_init_idc = static_cast<__u8>(slice_hdr->cabac_init_idc);
+  slice->slice_qp_delta = static_cast<__s8>(slice_hdr->slice_qp_delta);
+  slice->slice_qs_delta = static_cast<__s8>(slice_hdr->slice_qs_delta);
+  slice->disable_deblocking_filter_idc =
+      static_cast<__u8>(slice_hdr->disable_deblocking_filter_idc);
+  slice->slice_alpha_c0_offset_div2 =
+      static_cast<__s8>(slice_hdr->slice_alpha_c0_offset_div2);
+  slice->slice_beta_offset_div2 =
+      static_cast<__s8>(slice_hdr->slice_beta_offset_div2);
+  slice->num_ref_idx_l0_active_minus1 =
+      static_cast<__u8>(slice_hdr->num_ref_idx_l0_active_minus1);
+  slice->num_ref_idx_l1_active_minus1 =
+      static_cast<__u8>(slice_hdr->num_ref_idx_l1_active_minus1);
+  if (slice_type == V4L2_H264_SLICE_TYPE_B &&
+      slice_hdr->direct_spatial_mv_pred_flag) {
+    slice->flags |= V4L2_H264_SLICE_FLAG_DIRECT_SPATIAL_MV_PRED;
+  }
+  if (slice_hdr->sp_for_switch_flag) {
+    slice->flags |= V4L2_H264_SLICE_FLAG_SP_FOR_SWITCH;
+  }
+
+  if (slice_type == V4L2_H264_SLICE_TYPE_P ||
+      slice_type == V4L2_H264_SLICE_TYPE_SP ||
+      slice_type == V4L2_H264_SLICE_TYPE_B) {
+    if (!FillH264RefList(priv->dpb_pics, ref_pic_list0, slice->ref_pic_list0,
+                         slice_hdr->num_ref_idx_l0_active_minus1 + 1)) {
+      VLOGF(1) << "H.264 L0 reference is not in the DPB";
+      return false;
+    }
+  }
+  if (slice_type == V4L2_H264_SLICE_TYPE_B) {
+    if (!FillH264RefList(priv->dpb_pics, ref_pic_list1, slice->ref_pic_list1,
+                         slice_hdr->num_ref_idx_l1_active_minus1 + 1)) {
+      VLOGF(1) << "H.264 L1 reference is not in the DPB";
+      return false;
+    }
+  }
+
+  priv->pred_weights_required = false;
+  const bool weighted =
+      (pps->weighted_pred_flag && (slice_type == V4L2_H264_SLICE_TYPE_P ||
+                                   slice_type == V4L2_H264_SLICE_TYPE_SP)) ||
+      (pps->weighted_bipred_idc == 1 && slice_type == V4L2_H264_SLICE_TYPE_B);
+  if (weighted) {
+    priv->pred_weights_required = true;
+    struct v4l2_ctrl_h264_pred_weights* weights = &priv->pred_weights;
+    *weights = {};
+    weights->luma_log2_weight_denom =
+        static_cast<__u16>(slice_hdr->luma_log2_weight_denom);
+    weights->chroma_log2_weight_denom =
+        static_cast<__u16>(slice_hdr->chroma_log2_weight_denom);
+    const int n0 = std::min(slice_hdr->num_ref_idx_l0_active_minus1 + 1, 32);
+    const int n1 = std::min(slice_hdr->num_ref_idx_l1_active_minus1 + 1, 32);
+    for (int i = 0; i < n0; ++i) {
+      weights->weight_factors[0].luma_weight[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l0.luma_weight[i]);
+      weights->weight_factors[0].luma_offset[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l0.luma_offset[i]);
+      for (int j = 0; j < 2; ++j) {
+        weights->weight_factors[0].chroma_weight[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l0.chroma_weight[i][j]);
+        weights->weight_factors[0].chroma_offset[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l0.chroma_offset[i][j]);
+      }
+    }
+    for (int i = 0; i < n1; ++i) {
+      weights->weight_factors[1].luma_weight[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l1.luma_weight[i]);
+      weights->weight_factors[1].luma_offset[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l1.luma_offset[i]);
+      for (int j = 0; j < 2; ++j) {
+        weights->weight_factors[1].chroma_weight[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l1.chroma_weight[i][j]);
+        weights->weight_factors[1].chroma_offset[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l1.chroma_offset[i][j]);
+      }
+    }
+  }
+
+  priv->have_slice = true;
+  priv->slice_count++;
+  return true;
+}
