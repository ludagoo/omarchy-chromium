 namespace media {
 
+struct V4L2VideoDecoderDelegateH265Private {
+  std::vector<struct v4l2_ctrl_hevc_slice_params> slices;
+  // Same order as the DPB submitted in the decode-params control.
+  std::vector<scoped_refptr<H265Picture>> dpb_pics;
+  int32_t decode_mode = V4L2_STATELESS_HEVC_DECODE_MODE_FRAME_BASED;
+  int32_t start_code = V4L2_STATELESS_HEVC_START_CODE_ANNEX_B;
+  bool has_slice_params = false;
+  bool controls_queried = false;
+};
+
+void QueryHevcStatelessControls(V4L2Device* device,
+                                V4L2VideoDecoderDelegateH265Private* priv) {
+  if (priv->controls_queried) {
+    return;
+  }
+  priv->controls_queried = true;
+
+  struct v4l2_queryctrl query = {};
+  query.id = V4L2_CID_STATELESS_HEVC_DECODE_MODE;
+  if (device->Ioctl(VIDIOC_QUERYCTRL, &query) == 0 &&
+      !(query.flags & V4L2_CTRL_FLAG_DISABLED)) {
+    priv->decode_mode = query.default_value;
+  }
+  query = {};
+  query.id = V4L2_CID_STATELESS_HEVC_START_CODE;
+  if (device->Ioctl(VIDIOC_QUERYCTRL, &query) == 0 &&
+      !(query.flags & V4L2_CTRL_FLAG_DISABLED)) {
+    priv->start_code = query.default_value;
+  }
+  query = {};
+  query.id = V4L2_CID_STATELESS_HEVC_SLICE_PARAMS;
+  if (device->Ioctl(VIDIOC_QUERYCTRL, &query) == 0 &&
+      !(query.flags & V4L2_CTRL_FLAG_DISABLED)) {
+    priv->has_slice_params = true;
+  }
+  VLOGF(1) << "HEVC stateless decode_mode=" << priv->decode_mode
+           << " start_code=" << priv->start_code
+           << " slice_params=" << priv->has_slice_params;
+}
+
+int FindHevcDpbIndex(
+    const std::vector<scoped_refptr<H265Picture>>& dpb,
+    const H265Picture* pic) {
+  if (!pic) {
+    return -1;
+  }
+  for (size_t i = 0; i < dpb.size(); ++i) {
+    if (dpb[i].get() == pic) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+bool FillHevcRefIdx(const std::vector<scoped_refptr<H265Picture>>& dpb,
+                    const H265Picture::Vector& refs,
+                    __u8* out,
+                    int count) {
+  if (count < 0 || count > V4L2_HEVC_DPB_ENTRIES_NUM_MAX) {
+    return false;
+  }
+  for (int i = 0; i < count; ++i) {
+    if (i >= static_cast<int>(refs.size()) || !refs[i]) {
+      return false;
+    }
+    const int index = FindHevcDpbIndex(dpb, refs[i].get());
+    if (index < 0) {
+      return false;
+    }
+    out[i] = static_cast<__u8>(index);
+  }
+  return true;
+}
