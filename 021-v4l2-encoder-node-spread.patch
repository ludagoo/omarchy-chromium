 bool V4L2Device::Open(Type type, uint32_t v4l2_pixfmt) {
   DVLOGF(3);
-  std::string path = GetDevicePathFor(type, v4l2_pixfmt);
+  // Enumeration opens and closes nodes. Do that before taking the
+  // session lock: CloseDevice() releases a claim and must not run
+  // while this function holds EncoderSessionLock().
+  const Devices& devices = GetDevicesForType(type);
+
+  std::string path;
+  if (type == Type::kEncoder) {
+    base::AutoLock auto_lock(EncoderSessionLock());
+    std::string fallback;
+    auto& counts = EncoderSessionCount();
+    for (const auto& device : devices) {
+      if (!std::ranges::contains(device.second, v4l2_pixfmt)) {
+        continue;
+      }
+      if (fallback.empty()) {
+        fallback = device.first;
+      }
+      if (counts[device.first] < kAveSessionsPerNode) {
+        path = device.first;
+        break;
+      }
+    }
+    if (path.empty()) {
+      path = fallback;
+    }
+    if (!path.empty()) {
+      counts[path]++;
+      encoder_path_ = path;
+      VLOGF(1) << "AVE encoder " << path << " claimed, held "
+               << counts[path];
+    }
+  } else {
+    path = GetDevicePathFor(type, v4l2_pixfmt);
+  }
 
   if (path.empty()) {
     VLOGF(1) << "No devices supporting " << FourccToString(v4l2_pixfmt)
@@ -133,6 +184,7 @@
 
   if (!OpenDevicePath(path)) {
     VLOGF(1) << "Failed opening " << path;
+    ReleaseEncoderSession();
