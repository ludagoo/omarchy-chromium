+void V4L2Device::ReleaseEncoderSession() {
+  base::AutoLock auto_lock(EncoderSessionLock());
+  if (encoder_path_.empty()) {
+    return;
+  }
+  auto& counts = EncoderSessionCount();
+  auto it = counts.find(encoder_path_);
+  if (it != counts.end() && it->second > 0) {
+    --it->second;
+  }
+  encoder_path_.clear();
+}
+
 void V4L2Device::CloseDevice() {
   DVLOGF(3);
+  ReleaseEncoderSession();
   device_fd_.reset();
 }
 
