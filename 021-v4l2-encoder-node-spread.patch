+// apple-ave 6070 allows two sessions on each encoder node. A third
+// STREAMON on that node returns EBUSY while the other core is idle.
+// Open() claims a slot so encoders spread across /dev/video-encN.
+constexpr int kAveSessionsPerNode = 2;
+
+base::Lock& EncoderSessionLock() {
+  static base::NoDestructor<base::Lock> lock;
+  return *lock;
+}
+
+std::map<std::string, int>& EncoderSessionCount() {
+  static base::NoDestructor<std::map<std::string, int>> counts;
+  return *counts;
+}
+
 }  // namespace
 
