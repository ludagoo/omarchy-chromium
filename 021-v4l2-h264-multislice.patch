+bool V4L2StatelessVideoDecoderBackend::SubmitHeldSlice(
+    V4L2DecodeSurface* dec_surface,
+    const uint8_t* data,
+    size_t size,
+    bool queue_capture,
+    struct v4l2_ext_controls* ctrls) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!dec_surface || !data || size == 0 || !ctrls || !requests_queue_) {
+    return false;
+  }
+
+  if (!ReapCompletedInputBuffers()) {
+    client_->OnBackendError();
+    return false;
+  }
+  auto input_buf = input_queue_->GetFreeBuffer();
+  if (!input_buf) {
+    VLOGF(1) << "No free bitstream buffer for an H.264 slice";
+    client_->OnBackendError();
+    return false;
+  }
+  std::optional<V4L2RequestRef> request = requests_queue_->GetFreeRequest();
+  if (!request) {
+    VLOGF(1) << "No free media request for an H.264 slice";
+    client_->OnBackendError();
+    return false;
+  }
+
+  const size_t plane_size = input_buf->GetPlaneSize(0);
+  if (size > plane_size) {
+    VLOGF(1) << "H.264 slice (" << size << ") is larger than the bitstream"
+             << " buffer (" << plane_size << ")";
+    client_->OnBackendError();
+    return false;
+  }
+  void* mapping = input_buf->GetPlaneMapping(0);
+  if (!mapping) {
+    client_->OnBackendError();
+    return false;
+  }
+  UNSAFE_TODO(memcpy(mapping, data, size));
+  if (size < plane_size) {
+    const size_t pad = std::min<size_t>(64, plane_size - size);
+    UNSAFE_TODO(memset(static_cast<uint8_t*>(mapping) + size, 0, pad));
+  }
+  input_buf->SetPlaneBytesUsed(0, size);
+  // Same timestamp as the picture's CAPTURE buffer. Reference lists name that
+  // buffer, and every slice of the picture writes it.
+  struct timeval timestamp = {.tv_sec = 0,
+                              .tv_usec = dec_surface->output_record()};
+  input_buf->SetTimeStamp(timestamp);
+  input_buf->SetFlags(V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF);
+
+  if (!request->ApplyCtrls(ctrls) ||
+      device_->Ioctl(VIDIOC_S_EXT_CTRLS, ctrls) != 0) {
+    VPLOGF(1) << "Failed to set controls for a held H.264 slice";
+    client_->OnBackendError();
+    return false;
+  }
+
+  // Match libva-v4l2-request: queue the bitstream, then the CAPTURE buffer
+  // (first slice only), then the media request. Later slices leave the
+  // CAPTURE buffer queued and set V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF.
+  if (!std::move(*input_buf).QueueMMap(&(*request))) {
+    VLOGF(1) << "Failed to queue a held H.264 slice";
+    client_->OnBackendError();
+    return false;
+  }
+  if (queue_capture && !dec_surface->QueueCaptureBuffer()) {
+    VLOGF(1) << "Failed to queue the CAPTURE buffer for the first H.264 slice";
+    client_->OnBackendError();
+    return false;
+  }
+  std::optional<V4L2SubmittedRequestRef> submitted = std::move(*request).Submit();
+  if (!submitted) {
+    VLOGF(1) << "Failed to submit a held H.264 slice request";
+    client_->OnBackendError();
+    return false;
+  }
+  // The driver copies the slice and returns the bitstream buffer without
+  // decoding yet. Wait so the next slice can reuse a buffer. The CAPTURE
+  // buffer stays queued.
+  if (!submitted->WaitForCompletion(500)) {
+    VLOGF(1) << "Held H.264 slice request timed out";
+    client_->OnBackendError();
+    return false;
+  }
+  if (!ReapCompletedInputBuffers()) {
+    client_->OnBackendError();
+    return false;
+  }
+  return true;
+}
