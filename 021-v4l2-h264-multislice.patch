+// This struct contains the kernel-specific parts of the H264 acceleration,
+// that we don't want to expose in the .h file since they may differ from
+// upstream.
+struct V4L2VideoDecoderDelegateH264Private {
+  struct v4l2_ctrl_h264_decode_params v4l2_decode_param;
+  struct v4l2_ctrl_h264_slice_params slice_params = {};
+  struct v4l2_ctrl_h264_pred_weights pred_weights = {};
+  // Pictures in the same order as v4l2_decode_param.dpb[]. Slice ref lists
+  // name these slots, not timestamps.
+  std::vector<H264Picture*> dpb_pics;
+  bool pred_weights_required = false;
+  bool have_slice = false;
+  int slice_count = 0;
+  // ChromeOS stateless decoders are frame-based and parse Annex-B themselves.
+  // Mainline decoders (AVD, hantro, rkvdec, cedrus) advertise the real mode.
+  int32_t decode_mode = V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED;
+  int32_t start_code = V4L2_STATELESS_H264_START_CODE_ANNEX_B;
+  bool controls_queried = false;
+};
+
+void QueryH264StatelessControls(V4L2Device* device,
+                                V4L2VideoDecoderDelegateH264Private* priv) {
+  if (priv->controls_queried) {
+    return;
+  }
+  priv->controls_queried = true;
+
+  struct v4l2_queryctrl query = {};
+  query.id = V4L2_CID_STATELESS_H264_DECODE_MODE;
+  if (device->Ioctl(VIDIOC_QUERYCTRL, &query) == 0 &&
+      !(query.flags & V4L2_CTRL_FLAG_DISABLED)) {
+    priv->decode_mode = query.default_value;
+  }
+  query = {};
+  query.id = V4L2_CID_STATELESS_H264_START_CODE;
+  if (device->Ioctl(VIDIOC_QUERYCTRL, &query) == 0 &&
+      !(query.flags & V4L2_CTRL_FLAG_DISABLED)) {
+    priv->start_code = query.default_value;
+  }
+  VLOGF(1) << "H.264 stateless decode_mode=" << priv->decode_mode
+           << " start_code=" << priv->start_code;
+}
+
+int FindH264DpbIndex(const std::vector<H264Picture*>& dpb,
+                   const H264Picture* pic) {
+  if (!pic) {
+    return -1;
+  }
+  for (size_t i = 0; i < dpb.size(); ++i) {
+    if (dpb[i] == pic) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+bool FillH264RefList(const std::vector<H264Picture*>& dpb,
+                     const H264Picture::Vector& refs,
+                     struct v4l2_h264_reference* out,
+                     int count) {
+  if (count < 0 || count > V4L2_H264_REF_LIST_LEN) {
+    return false;
+  }
+  // The slice header asks for num_ref_idx_lX_active entries. Early in a GOP
+  // fewer reference pictures exist, and the parser leaves the spare slots
+  // null. A slice-based driver still checks every active index, so those
+  // slots repeat the last real reference. The bitstream does not address them.
+  int fallback = -1;
+  for (int i = 0; i < count; ++i) {
+    int index = -1;
+    if (i < static_cast<int>(refs.size()) && refs[i]) {
+      index = FindH264DpbIndex(dpb, refs[i].get());
+      if (index < 0) {
+        return false;
+      }
+      fallback = index;
+    } else if (fallback >= 0) {
+      index = fallback;
+    } else {
+      return false;
+    }
+    out[i].index = static_cast<__u8>(index);
+    out[i].fields = V4L2_H264_FRAME_REF;
+  }
+  return true;
+}
+
+// One slice per request. A second slice in the same picture needs
+// V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF and its own media request, which this
+// one-buffer surface does not do yet.
+bool FillH264SliceParams(V4L2VideoDecoderDelegateH264Private* priv,
+                         const H264PPS* pps,
+                         const H264SliceHeader* slice_hdr,
+                         const H264Picture::Vector& ref_pic_list0,
+                         const H264Picture::Vector& ref_pic_list1) {
+  if (priv->slice_count >= 1) {
+    VLOGF(1) << "Slice-based H.264 picture has more than one slice. "
+             << "Each slice needs its own request.";
+    return false;
+  }
+  if (slice_hdr->header_bit_size < 0) {
+    return false;
+  }
+
+  const int slice_type = slice_hdr->slice_type % 5;
+  struct v4l2_ctrl_h264_slice_params* slice = &priv->slice_params;
+  *slice = {};
+  // header_bit_size counts RBSP bits from the first byte of the NAL (the
+  // NAL header), with emulation-prevention bytes excluded. The kernel
+  // scanner skips those bytes itself and adds the CABAC alignment.
+  slice->header_bit_size = static_cast<__u32>(slice_hdr->header_bit_size);
+  slice->first_mb_in_slice = static_cast<__u32>(slice_hdr->first_mb_in_slice);
+  slice->slice_type = static_cast<__u8>(slice_type);
+  slice->colour_plane_id = static_cast<__u8>(slice_hdr->colour_plane_id);
+  slice->redundant_pic_cnt = static_cast<__u8>(slice_hdr->redundant_pic_cnt);
+  slice->cabac_init_idc = static_cast<__u8>(slice_hdr->cabac_init_idc);
+  slice->slice_qp_delta = static_cast<__s8>(slice_hdr->slice_qp_delta);
+  slice->slice_qs_delta = static_cast<__s8>(slice_hdr->slice_qs_delta);
+  slice->disable_deblocking_filter_idc =
+      static_cast<__u8>(slice_hdr->disable_deblocking_filter_idc);
+  slice->slice_alpha_c0_offset_div2 =
+      static_cast<__s8>(slice_hdr->slice_alpha_c0_offset_div2);
+  slice->slice_beta_offset_div2 =
+      static_cast<__s8>(slice_hdr->slice_beta_offset_div2);
+  slice->num_ref_idx_l0_active_minus1 =
+      static_cast<__u8>(slice_hdr->num_ref_idx_l0_active_minus1);
+  slice->num_ref_idx_l1_active_minus1 =
+      static_cast<__u8>(slice_hdr->num_ref_idx_l1_active_minus1);
+  if (slice_type == V4L2_H264_SLICE_TYPE_B &&
+      slice_hdr->direct_spatial_mv_pred_flag) {
+    slice->flags |= V4L2_H264_SLICE_FLAG_DIRECT_SPATIAL_MV_PRED;
+  }
+  if (slice_hdr->sp_for_switch_flag) {
+    slice->flags |= V4L2_H264_SLICE_FLAG_SP_FOR_SWITCH;
+  }
+
+  if (slice_type == V4L2_H264_SLICE_TYPE_P ||
+      slice_type == V4L2_H264_SLICE_TYPE_SP ||
+      slice_type == V4L2_H264_SLICE_TYPE_B) {
+    if (!FillH264RefList(priv->dpb_pics, ref_pic_list0, slice->ref_pic_list0,
+                         slice_hdr->num_ref_idx_l0_active_minus1 + 1)) {
+      VLOGF(1) << "H.264 L0 reference is not in the DPB"
+               << " list=" << ref_pic_list0.size()
+               << " active=" << (slice_hdr->num_ref_idx_l0_active_minus1 + 1)
+               << " dpb=" << priv->dpb_pics.size();
+      return false;
+    }
+  }
+  if (slice_type == V4L2_H264_SLICE_TYPE_B) {
+    if (!FillH264RefList(priv->dpb_pics, ref_pic_list1, slice->ref_pic_list1,
+                         slice_hdr->num_ref_idx_l1_active_minus1 + 1)) {
+      VLOGF(1) << "H.264 L1 reference is not in the DPB";
+      return false;
+    }
+  }
+
+  priv->pred_weights_required = false;
+  const bool weighted =
+      (pps->weighted_pred_flag && (slice_type == V4L2_H264_SLICE_TYPE_P ||
+                                   slice_type == V4L2_H264_SLICE_TYPE_SP)) ||
+      (pps->weighted_bipred_idc == 1 && slice_type == V4L2_H264_SLICE_TYPE_B);
+  if (weighted) {
+    priv->pred_weights_required = true;
+    struct v4l2_ctrl_h264_pred_weights* weights = &priv->pred_weights;
+    *weights = {};
+    weights->luma_log2_weight_denom =
+        static_cast<__u16>(slice_hdr->luma_log2_weight_denom);
+    weights->chroma_log2_weight_denom =
+        static_cast<__u16>(slice_hdr->chroma_log2_weight_denom);
+    const int n0 = std::min(slice_hdr->num_ref_idx_l0_active_minus1 + 1, 32);
+    const int n1 = std::min(slice_hdr->num_ref_idx_l1_active_minus1 + 1, 32);
+    for (int i = 0; i < n0; ++i) {
+      weights->weight_factors[0].luma_weight[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l0.luma_weight[i]);
+      weights->weight_factors[0].luma_offset[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l0.luma_offset[i]);
+      for (int j = 0; j < 2; ++j) {
+        weights->weight_factors[0].chroma_weight[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l0.chroma_weight[i][j]);
+        weights->weight_factors[0].chroma_offset[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l0.chroma_offset[i][j]);
+      }
+    }
+    for (int i = 0; i < n1; ++i) {
+      weights->weight_factors[1].luma_weight[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l1.luma_weight[i]);
+      weights->weight_factors[1].luma_offset[i] = static_cast<__s16>(
+          slice_hdr->pred_weight_table_l1.luma_offset[i]);
+      for (int j = 0; j < 2; ++j) {
+        weights->weight_factors[1].chroma_weight[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l1.chroma_weight[i][j]);
+        weights->weight_factors[1].chroma_offset[i][j] = static_cast<__s16>(
+            slice_hdr->pred_weight_table_l1.chroma_offset[i][j]);
+      }
+    }
+  }
+
+  priv->have_slice = true;
+  priv->slice_count++;
+  return true;
+}
