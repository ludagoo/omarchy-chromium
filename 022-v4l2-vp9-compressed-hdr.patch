+// Fills |hdr| with this frame's compressed-header deltas and |reference_mode|
+// with the inter prediction mode (single, compound, or select). A frame with
+// no compressed header leaves both at zero.
+bool ParseVp9CompressedHeader(const Vp9FrameHeader& frame,
+                              struct v4l2_ctrl_vp9_compressed_hdr* hdr,
+                              uint8_t* reference_mode) {
+  *hdr = {};
+  *reference_mode = 0;
+  if (frame.header_size_in_bytes == 0) {
+    return true;
+  }
+  const size_t compressed_end =
+      frame.uncompressed_header_size + frame.header_size_in_bytes;
+  if (compressed_end < frame.uncompressed_header_size ||
+      compressed_end > frame.data.size()) {
+    return false;
+  }
+  const auto compressed = frame.data.subspan(frame.uncompressed_header_size,
+                                              frame.header_size_in_bytes);
+
+  Vp9Bool c;
+  if (!c.Init(compressed.data(), compressed.size())) {
+    return false;
+  }
+  // The marker bit must be zero.
+  if (c.Bit(128)) {
+    return false;
+  }
+
+  if (frame.quant_params.IsLossless()) {
+    hdr->tx_mode = V4L2_VP9_TX_MODE_ONLY_4X4;
+  } else {
+    hdr->tx_mode = static_cast<uint8_t>(c.Lit(2));
+    if (hdr->tx_mode == V4L2_VP9_TX_MODE_ALLOW_32X32) {
+      hdr->tx_mode = static_cast<uint8_t>(hdr->tx_mode + c.Bit(128));
+    }
+    if (hdr->tx_mode == V4L2_VP9_TX_MODE_SELECT) {
+      for (int i = 0; i < 2; i++) {
+        UpdateProb(&c, &hdr->tx8[i][0]);
+      }
+      for (int i = 0; i < 2; i++) {
+        for (int j = 0; j < 2; j++) {
+          UpdateProb(&c, &hdr->tx16[i][j]);
+        }
+      }
+      for (int i = 0; i < 2; i++) {
+        for (int j = 0; j < 3; j++) {
+          UpdateProb(&c, &hdr->tx32[i][j]);
+        }
+      }
+    }
+  }
+
+  for (unsigned int i = 0; i < 4; i++) {
+    if (c.Bit(128)) {
+      for (int j = 0; j < 2; j++) {
+        for (int k = 0; k < 2; k++) {
+          for (int l = 0; l < 6; l++) {
+            for (int m = 0; m < 6; m++) {
+              if (m >= 3 && l == 0) {
+                break;
+              }
+              for (int n = 0; n < 3; n++) {
+                UpdateProb(&c, &hdr->coef[i][j][k][l][m][n]);
+              }
+            }
+          }
+        }
+      }
+    }
+    if (hdr->tx_mode == i) {
+      break;
+    }
+  }
+
+  for (int i = 0; i < 3; i++) {
+    UpdateProb(&c, &hdr->skip[i]);
+  }
+  if (frame.IsIntra()) {
+    return c.Valid();
+  }
+
+  for (int i = 0; i < 7; i++) {
+    for (int j = 0; j < 3; j++) {
+      UpdateProb(&c, &hdr->inter_mode[i][j]);
+    }
+  }
+  if (frame.interpolation_filter == Vp9InterpolationFilter::SWITCHABLE) {
+    for (int i = 0; i < 4; i++) {
+      for (int j = 0; j < 2; j++) {
+        UpdateProb(&c, &hdr->interp_filter[i][j]);
+      }
+    }
+  }
+  for (int i = 0; i < 4; i++) {
+    UpdateProb(&c, &hdr->is_inter[i]);
+  }
+
+  const bool last_bias = frame.ref_frame_sign_bias[VP9_FRAME_LAST];
+  const bool golden_bias = frame.ref_frame_sign_bias[VP9_FRAME_GOLDEN];
+  const bool alt_bias = frame.ref_frame_sign_bias[VP9_FRAME_ALTREF];
+  unsigned int comp_pred = 0;
+  if (last_bias != golden_bias || last_bias != alt_bias) {
+    comp_pred = static_cast<unsigned int>(c.Bit(128));
+    if (comp_pred) {
+      comp_pred += static_cast<unsigned int>(c.Bit(128));
+    }
+    if (comp_pred == V4L2_VP9_REFERENCE_MODE_SELECT) {
+      for (int i = 0; i < 5; i++) {
+        UpdateProb(&c, &hdr->comp_mode[i]);
+      }
+    }
+  }
+  if (comp_pred != V4L2_VP9_REFERENCE_MODE_COMPOUND_REFERENCE) {
+    for (int i = 0; i < 5; i++) {
+      UpdateProb(&c, &hdr->single_ref[i][0]);
+      UpdateProb(&c, &hdr->single_ref[i][1]);
+    }
+  }
+  if (comp_pred != V4L2_VP9_REFERENCE_MODE_SINGLE_REFERENCE) {
+    for (int i = 0; i < 5; i++) {
+      UpdateProb(&c, &hdr->comp_ref[i]);
+    }
+  }
+
+  for (int i = 0; i < 4; i++) {
+    for (int j = 0; j < 9; j++) {
+      UpdateProb(&c, &hdr->y_mode[i][j]);
+    }
+  }
+  for (int i = 0; i < 4; i++) {
+    for (int j = 0; j < 4; j++) {
+      for (int k = 0; k < 3; k++) {
+        UpdateProb(&c, &hdr->partition[i * 4 + j][k]);
+      }
+    }
+  }
+
+  for (int i = 0; i < 3; i++) {
+    UpdateMv(&c, &hdr->mv.joint[i]);
+  }
+  for (int i = 0; i < 2; i++) {
+    UpdateMv(&c, &hdr->mv.sign[i]);
+    for (int j = 0; j < 10; j++) {
+      UpdateMv(&c, &hdr->mv.classes[i][j]);
+    }
+    UpdateMv(&c, &hdr->mv.class0_bit[i]);
+    for (int j = 0; j < 10; j++) {
+      UpdateMv(&c, &hdr->mv.bits[i][j]);
+    }
+  }
+  for (int i = 0; i < 2; i++) {
+    for (int j = 0; j < 2; j++) {
+      for (int k = 0; k < 3; k++) {
+        UpdateMv(&c, &hdr->mv.class0_fr[i][j][k]);
+      }
+    }
+    for (int j = 0; j < 3; j++) {
+      UpdateMv(&c, &hdr->mv.fr[i][j]);
+    }
+  }
+  if (frame.allow_high_precision_mv) {
+    for (int i = 0; i < 2; i++) {
+      UpdateMv(&c, &hdr->mv.class0_hp[i]);
+      UpdateMv(&c, &hdr->mv.hp[i]);
+    }
+  }
+
+  *reference_mode = static_cast<uint8_t>(comp_pred);
+  return c.Valid();
+}
