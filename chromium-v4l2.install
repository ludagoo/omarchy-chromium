post_install() {
  udevadm control --reload-rules || true
  udevadm trigger --subsystem-match=video4linux --subsystem-match=media || true
}

post_upgrade() {
  post_install
}

post_remove() {
  udevadm control --reload-rules || true
  udevadm trigger --subsystem-match=video4linux --subsystem-match=media || true
}
