post_install() {
  udevadm control --reload-rules || true
  # The rules match ACTION=="add". A plain trigger sends "change" and
  # leaves the symlinks missing until the next real device add.
  udevadm trigger --action=add --subsystem-match=video4linux --subsystem-match=media || true
}

post_upgrade() {
  post_install
}

post_remove() {
  udevadm control --reload-rules || true
  udevadm trigger --action=add --subsystem-match=video4linux --subsystem-match=media || true
}
