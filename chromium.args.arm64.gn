is_official_build = true
symbol_level = 0
treat_warnings_as_errors = false
fatal_linker_warnings = false
disable_fieldtrial_testing_config = true
blink_enable_generated_code_formatting = false
ffmpeg_branding = "Chrome"
proprietary_codecs = true
rtc_use_pipewire = true
link_pulseaudio = true
use_custom_libcxx = true
enable_hangout_services_extension = true
enable_widevine = true
enable_nacl = false
use_qt5 = false
use_qt6 = true
moc_qt6_path = "/usr/lib/qt6"
# use_partition_alloc = true
google_api_key = "AIzaSyDwr302FpOSkGRpLlUpPThNTDPbXcIn_FM"
dcheck_always_on = false
is_debug = false
# use_sysroot = false
# v8_enable_debugging_features = false
# clang_base_path = "/usr"
# clang_use_chrome_plugins = false
# clang_version = "20"

target_cpu = "arm64"
target_os = "linux"

# Local build. Omarchy's RBE (use_remoteexec / use_siso) is not available
# on the SmartRoom studio build VM.
use_remoteexec = false
use_siso = false

# Direct V4L2. media/gpu/args.gni leaves use_v4l2_codec default false.
# use_vaapi defaults true on Linux arm64 when ozone X11 or Wayland is on
# (ozone.gni turns both on for is_linux), so it is set false here on purpose.
# video_decoder_pipeline.cc is #if USE_VAAPI / #elif USE_V4L2_CODEC, so VA-API
# off selects V4L2VideoDecoder. AVD only advertises slice/frame fourccs, so
# IsV4L2DecoderStateful() is false and the stateless request-API backend is
# used. 004-linux-v4l2-encode-keep-vaapi.patch still builds the stateful
# encoder on Linux and registers it ahead of VA-API. The mutual-exclusion
# assert is not load-bearing once only one flag is set.
# 013-v4l2-decode-feature-default.patch turns AcceleratedVideoDecoder on
# for this build. Encode stays gated on AcceleratedVideoEncoder.
use_v4l2_codec = true
use_vaapi = false

# Official ThinLTO links do not fit in 31 GB with the rest of the machine
# awake. PGO profile download is skipped. One link at a time. is_cfi
# defaults on for some official builds and requires ThinLTO
# (build/config/compiler/compiler.gni).
use_thin_lto = false
is_cfi = false
chrome_pgo_phase = 0
concurrent_links = 1
