blink_enable_generated_code_formatting = false
ffmpeg_branding = "Chrome"
proprietary_codecs = true
rtc_use_pipewire = true
link_pulseaudio = true
use_custom_libcxx = true
enable_hangout_services_extension = true
enable_widevine = true
enable_nacl = false
use_qt5 = false
use_qt6 = true
moc_qt6_path = "/usr/lib/qt6"
# use_partition_alloc = true
google_api_key = "AIzaSyDwr302FpOSkGRpLlUpPThNTDPbXcIn_FM"
dcheck_always_on = false
is_debug = false
# use_sysroot = false
# v8_enable_debugging_features = false
# clang_base_path = "/usr"
# clang_use_chrome_plugins = false
# clang_version = "20"

target_cpu = "arm64"
target_os = "linux"

# Local build. Omarchy's RBE (use_remoteexec / use_siso) is not available
# on the SmartRoom studio build VM.
use_remoteexec = false
use_siso = false

# V4L2 stateless decode + stateful encode, and VA-API together.
# media/gpu/args.gni leaves use_v4l2_codec default false. use_vaapi defaults
# true on Linux arm64 when ozone X11 or Wayland is on (ozone.gni turns both
# on for is_linux). Chromium 148 still assert()s that the two are exclusive
# (media/gpu/BUILD.gn and media/gpu/chromeos/BUILD.gn) and only compiles
# v4l2_video_encode_accelerator.cc when is_chromeos. The encoder factory
# returns nullptr on Linux. 004-linux-v4l2-encode-keep-vaapi.patch lifts that.
# With both flags set, video_decoder_pipeline.cc keeps the VA-API decoder
# (#if USE_VAAPI / #elif USE_V4L2), so libva-v4l2-request still decodes.
# The V4L2 stateless decoder is compiled but not selected while USE_VAAPI
# is set. The encoder factory tries V4L2 first, then VA-API.
use_v4l2_codec = true
use_vaapi = true

# 8 vCPU / 16 GB RAM. Official ThinLTO links do not fit. PGO profile download
# is skipped. One link at a time. is_cfi defaults on for some official builds
# and requires ThinLTO (build/config/compiler/compiler.gni).
use_thin_lto = false
is_cfi = false
chrome_pgo_phase = 0
concurrent_links = 1
