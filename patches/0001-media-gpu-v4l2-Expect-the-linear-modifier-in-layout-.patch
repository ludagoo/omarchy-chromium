From dfd25fe42d45566403377aa3f6206a5534eebf31 Mon Sep 17 00:00:00 2001
From: Lucas Goossen <lucas.goossen@hey.com>
Date: Thu, 19 Nov 2026 09:10:39 -0300
Subject: [PATCH 1/7] media/gpu/v4l2: Expect the linear modifier in layout
 tests on Linux

V4L2FormatToVideoFrameLayout() sets DRM_FORMAT_MOD_LINEAR on Linux
(DRM_FORMAT_MOD_MTK_16L_32S_TILE for MM21) and leaves the modifier at
gfx::NativePixmapHandle::kNoModifier on ChromeOS. The NV12, NV12M and
YUV420 layout tests always expect kNoModifier, so they fail in a Linux
build with use_v4l2_codec=true:

  Which is: "... modifier: 0x0)"
  Which is: "... modifier: 0xffffffffffffff)"

Expect the modifier the function sets on the platform under test. No
change to the code under test.

Bug: None
Test: media_unittests --gtest_filter=V4L2UtilsTest.* (Linux arm64,
      use_v4l2_codec=true): NV12, NV12M and YUV420 failed before
Assisted-by: Claude:claude-opus-5-5
---
 media/gpu/v4l2/BUILD.gn               |  1 +
 media/gpu/v4l2/v4l2_utils_unittest.cc | 30 +++++++++++++++++++--------
 2 files changed, 22 insertions(+), 9 deletions(-)

diff --git a/media/gpu/v4l2/BUILD.gn b/media/gpu/v4l2/BUILD.gn
index 504ae16..5c04513 100644
--- a/media/gpu/v4l2/BUILD.gn
+++ b/media/gpu/v4l2/BUILD.gn
@@ -159,6 +159,7 @@ source_set("unit_test") {
   deps = [
     ":v4l2",
     "//base",
+    "//build/config/linux/libdrm",
     "//media",
     "//media:test_support",
     "//testing/gtest",
diff --git a/media/gpu/v4l2/v4l2_utils_unittest.cc b/media/gpu/v4l2/v4l2_utils_unittest.cc
index d3e958b..7a984e3 100644
--- a/media/gpu/v4l2/v4l2_utils_unittest.cc
+++ b/media/gpu/v4l2/v4l2_utils_unittest.cc
@@ -9,6 +9,7 @@
 #include <vector>
 
 #include "base/compiler_specific.h"
+#include "build/build_config.h"
 #include "media/base/color_plane_layout.h"
 #include "media/base/video_frame_layout.h"
 #include "media/base/video_types.h"
@@ -16,6 +17,10 @@
 #include "testing/gtest/include/gtest/gtest.h"
 #include "ui/gfx/native_pixmap_handle.h"
 
+#if BUILDFLAG(IS_LINUX)
+#include <drm_fourcc.h>
+#endif
+
 namespace {
 
 // Composes a v4l2_format of type V4L2_BUF_TYPE_VIDEO_OUTPUT.
@@ -75,6 +80,16 @@ static std::string ModifierToHexString(uint64_t modifier) {
   return stream.str();
 }
 
+// V4L2FormatToVideoFrameLayout() marks the buffers linear on Linux and leaves
+// the modifier unset on ChromeOS.
+std::string ExpectedModifierString() {
+#if BUILDFLAG(IS_LINUX)
+  return ModifierToHexString(DRM_FORMAT_MOD_LINEAR);
+#else
+  return ModifierToHexString(gfx::NativePixmapHandle::kNoModifier);
+#endif
+}
+
 }  // namespace
 
 namespace media {
@@ -93,14 +108,13 @@ TEST(V4L2UtilsTest, V4L2FormatToVideoFrameLayoutNV12) {
   EXPECT_EQ(layout->is_multi_planar(), false);
   std::ostringstream ostream;
   ostream << *layout;
-  const std::string kNoModifierStr =
-      ModifierToHexString(gfx::NativePixmapHandle::kNoModifier);
+  const std::string kModifierStr = ExpectedModifierString();
   EXPECT_EQ(
       ostream.str(),
       "VideoFrameLayout(format: PIXEL_FORMAT_NV12, coded_size: 300x180, "
       "planes (stride, offset, size): [(320, 0, 86400), (320, 57600, 28800)], "
       "is_multi_planar: 0, buffer_addr_align: 4096, modifier: " +
-          kNoModifierStr + ")");
+          kModifierStr + ")");
 }
 
 // Test V4L2FormatToVideoFrameLayout with NV12M pixelformat, which has two
@@ -117,14 +131,13 @@ TEST(V4L2UtilsTest, V4L2FormatToVideoFrameLayoutNV12M) {
   EXPECT_EQ(layout->is_multi_planar(), true);
   std::ostringstream ostream;
   ostream << *layout;
-  const std::string kNoModifierStr =
-      ModifierToHexString(gfx::NativePixmapHandle::kNoModifier);
+  const std::string kModifierStr = ExpectedModifierString();
   EXPECT_EQ(
       ostream.str(),
       "VideoFrameLayout(format: PIXEL_FORMAT_NV12, coded_size: 300x180, "
       "planes (stride, offset, size): [(320, 0, 57600), (320, 0, 28800)], "
       "is_multi_planar: 1, buffer_addr_align: 4096, modifier: " +
-          kNoModifierStr + ")");
+          kModifierStr + ")");
 }
 
 // Test V4L2FormatToVideoFrameLayout with YUV420 pixelformat, which has one
@@ -140,14 +153,13 @@ TEST(V4L2UtilsTest, V4L2FormatToVideoFrameLayoutYUV420) {
   EXPECT_EQ(expected_planes, layout->planes());
   std::ostringstream ostream;
   ostream << *layout;
-  const std::string kNoModifierStr =
-      ModifierToHexString(gfx::NativePixmapHandle::kNoModifier);
+  const std::string kModifierStr = ExpectedModifierString();
   EXPECT_EQ(ostream.str(),
             "VideoFrameLayout(format: PIXEL_FORMAT_I420, coded_size: 300x180, "
             "planes (stride, offset, size): [(320, 0, 86400), (160, 57600, "
             "14400), (160, 72000, 14400)], "
             "is_multi_planar: 0, buffer_addr_align: 4096, modifier: " +
-                kNoModifierStr + ")");
+                kModifierStr + ")");
 }
 
 // Test V4L2FormatToVideoFrameLayout with single planar v4l2_format.
-- 
