diff --git a/media/gpu/v4l2/v4l2_h264_slice.cc b/media/gpu/v4l2/v4l2_h264_slice.cc
new file mode 100644
index 00000000..ca9c16b4
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_h264_slice.cc
@@ -0,0 +1,184 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/v4l2_h264_slice.h"
+
+#include <algorithm>
+
+#include "base/logging.h"
+#include "media/gpu/macros.h"
+
+namespace media {
+
+namespace {
+
+void FillH264WeightFactors(const H264WeightingFactors& table,
+                           int count,
+                           v4l2_h264_weight_factors& out) {
+  for (int i = 0; i < count; ++i) {
+    out.luma_weight[i] = static_cast<__s16>(table.luma_weight[i]);
+    out.luma_offset[i] = static_cast<__s16>(table.luma_offset[i]);
+    for (int j = 0; j < 2; ++j) {
+      out.chroma_weight[i][j] = static_cast<__s16>(table.chroma_weight[i][j]);
+      out.chroma_offset[i][j] = static_cast<__s16>(table.chroma_offset[i][j]);
+    }
+  }
+}
+
+}  // namespace
+
+bool H264DecodeModeIsSliceBased(int32_t decode_mode) {
+  return decode_mode == V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED;
+}
+
+int32_t ChooseH264DecodeMode(int32_t default_mode, bool frame_based_offered) {
+  return frame_based_offered ? V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED
+                             : default_mode;
+}
+
+std::vector<uint8_t> H264SliceForDriver(base::span<const uint8_t> nal,
+                                        int32_t start_code) {
+  std::vector<uint8_t> out;
+  if (start_code == V4L2_STATELESS_H264_START_CODE_NONE) {
+    while (!nal.empty() && nal.back() == 0x00) {
+      nal = nal.first(nal.size() - 1);
+    }
+  } else {
+    out = {0x00, 0x00, 0x01};
+  }
+  if (nal.empty()) {
+    return {};
+  }
+  out.insert(out.end(), nal.begin(), nal.end());
+  return out;
+}
+
+int FindH264DpbIndex(base::span<const scoped_refptr<H264Picture>> dpb,
+                     const H264Picture* pic) {
+  if (!pic) {
+    return -1;
+  }
+  for (size_t i = 0; i < dpb.size(); ++i) {
+    if (dpb[i].get() == pic) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+bool FillH264RefList(base::span<const scoped_refptr<H264Picture>> dpb,
+                     const H264Picture::Vector& refs,
+                     base::span<v4l2_h264_reference> out) {
+  int fallback = -1;
+  for (size_t i = 0; i < out.size(); ++i) {
+    int index = fallback;
+    if (i < refs.size() && refs[i]) {
+      index = FindH264DpbIndex(dpb, refs[i].get());
+      if (index < 0) {
+        return false;
+      }
+      fallback = index;
+    }
+    if (index < 0) {
+      return false;
+    }
+    out[i].index = static_cast<__u8>(index);
+    out[i].fields = V4L2_H264_FRAME_REF;
+  }
+  return true;
+}
+
+bool FillH264SliceParams(const H264PPS& pps,
+                         const H264SliceHeader& slice_hdr,
+                         base::span<const scoped_refptr<H264Picture>> dpb,
+                         const H264Picture::Vector& ref_pic_list0,
+                         const H264Picture::Vector& ref_pic_list1,
+                         v4l2_ctrl_h264_slice_params& slice,
+                         v4l2_ctrl_h264_pred_weights& weights,
+                         bool& pred_weights_required) {
+  if (slice_hdr.header_bit_size < 0) {
+    return false;
+  }
+
+  const int slice_type = slice_hdr.slice_type % 5;
+  slice = {};
+  // header_bit_size counts RBSP bits from the first byte of the NAL (the NAL
+  // header), with emulation-prevention bytes excluded, which is what the uAPI
+  // asks for.
+  slice.header_bit_size = static_cast<__u32>(slice_hdr.header_bit_size);
+  slice.first_mb_in_slice = static_cast<__u32>(slice_hdr.first_mb_in_slice);
+  slice.slice_type = static_cast<__u8>(slice_type);
+  slice.colour_plane_id = static_cast<__u8>(slice_hdr.colour_plane_id);
+  slice.redundant_pic_cnt = static_cast<__u8>(slice_hdr.redundant_pic_cnt);
+  slice.cabac_init_idc = static_cast<__u8>(slice_hdr.cabac_init_idc);
+  slice.slice_qp_delta = static_cast<__s8>(slice_hdr.slice_qp_delta);
+  slice.slice_qs_delta = static_cast<__s8>(slice_hdr.slice_qs_delta);
+  slice.disable_deblocking_filter_idc =
+      static_cast<__u8>(slice_hdr.disable_deblocking_filter_idc);
+  slice.slice_alpha_c0_offset_div2 =
+      static_cast<__s8>(slice_hdr.slice_alpha_c0_offset_div2);
+  slice.slice_beta_offset_div2 =
+      static_cast<__s8>(slice_hdr.slice_beta_offset_div2);
+  slice.num_ref_idx_l0_active_minus1 =
+      static_cast<__u8>(slice_hdr.num_ref_idx_l0_active_minus1);
+  slice.num_ref_idx_l1_active_minus1 =
+      static_cast<__u8>(slice_hdr.num_ref_idx_l1_active_minus1);
+  if (slice_type == V4L2_H264_SLICE_TYPE_B &&
+      slice_hdr.direct_spatial_mv_pred_flag) {
+    slice.flags |= V4L2_H264_SLICE_FLAG_DIRECT_SPATIAL_MV_PRED;
+  }
+  if (slice_hdr.sp_for_switch_flag) {
+    slice.flags |= V4L2_H264_SLICE_FLAG_SP_FOR_SWITCH;
+  }
+
+  const size_t n0 =
+      static_cast<size_t>(slice_hdr.num_ref_idx_l0_active_minus1) + 1;
+  const size_t n1 =
+      static_cast<size_t>(slice_hdr.num_ref_idx_l1_active_minus1) + 1;
+  if (n0 > std::size(slice.ref_pic_list0) ||
+      n1 > std::size(slice.ref_pic_list1)) {
+    return false;
+  }
+  if (slice_type == V4L2_H264_SLICE_TYPE_P ||
+      slice_type == V4L2_H264_SLICE_TYPE_SP ||
+      slice_type == V4L2_H264_SLICE_TYPE_B) {
+    if (!FillH264RefList(dpb, ref_pic_list0,
+                         base::span(slice.ref_pic_list0).first(n0))) {
+      VLOGF(1) << "H.264 L0 reference is not in the DPB, list="
+               << ref_pic_list0.size() << " active=" << n0
+               << " dpb=" << dpb.size();
+      return false;
+    }
+  }
+  if (slice_type == V4L2_H264_SLICE_TYPE_B) {
+    if (!FillH264RefList(dpb, ref_pic_list1,
+                         base::span(slice.ref_pic_list1).first(n1))) {
+      VLOGF(1) << "H.264 L1 reference is not in the DPB, list="
+               << ref_pic_list1.size() << " active=" << n1
+               << " dpb=" << dpb.size();
+      return false;
+    }
+  }
+
+  pred_weights_required =
+      (pps.weighted_pred_flag && (slice_type == V4L2_H264_SLICE_TYPE_P ||
+                                  slice_type == V4L2_H264_SLICE_TYPE_SP)) ||
+      (pps.weighted_bipred_idc == 1 && slice_type == V4L2_H264_SLICE_TYPE_B);
+  if (pred_weights_required) {
+    weights = {};
+    weights.luma_log2_weight_denom =
+        static_cast<__u16>(slice_hdr.luma_log2_weight_denom);
+    weights.chroma_log2_weight_denom =
+        static_cast<__u16>(slice_hdr.chroma_log2_weight_denom);
+    FillH264WeightFactors(slice_hdr.pred_weight_table_l0, static_cast<int>(n0),
+                          weights.weight_factors[0]);
+    if (slice_type == V4L2_H264_SLICE_TYPE_B) {
+      FillH264WeightFactors(slice_hdr.pred_weight_table_l1,
+                            static_cast<int>(n1), weights.weight_factors[1]);
+    }
+  }
+  return true;
+}
+
+}  // namespace media
diff --git a/media/gpu/v4l2/v4l2_h264_slice.h b/media/gpu/v4l2/v4l2_h264_slice.h
new file mode 100644
index 00000000..c559056a
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_h264_slice.h
@@ -0,0 +1,64 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_GPU_V4L2_V4L2_H264_SLICE_H_
+#define MEDIA_GPU_V4L2_V4L2_H264_SLICE_H_
+
+#include <linux/v4l2-controls.h>
+#include <stdint.h>
+
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "media/gpu/h264_dpb.h"
+#include "media/parsers/h264_parser.h"
+
+namespace media {
+
+// True for V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED. Slice-based devices
+// take one slice per request with V4L2_CID_STATELESS_H264_SLICE_PARAMS.
+bool H264DecodeModeIsSliceBased(int32_t decode_mode);
+
+// FRAME_BASED whenever the device offers it, so a device that supports both
+// modes stays on the frame-based path. Otherwise the driver's default.
+int32_t ChooseH264DecodeMode(int32_t default_mode, bool frame_based_offered);
+
+// The bytes a slice-based device receives for one slice NAL (|nal|, without
+// a start code). For V4L2_STATELESS_H264_START_CODE_ANNEX_B that is a 3-byte
+// start code and the NAL. For START_CODE_NONE it is the raw NAL without
+// trailing 0x00 bytes: those are the zero_byte of the next start code, and a
+// slice-based decoder would read them as slice data. Empty if nothing is left.
+std::vector<uint8_t> H264SliceForDriver(base::span<const uint8_t> nal,
+                                        int32_t start_code);
+
+// Index of |pic| in |dpb|, or -1. Slice reference lists name these slots.
+int FindH264DpbIndex(base::span<const scoped_refptr<H264Picture>> dpb,
+                     const H264Picture* pic);
+
+// Fills every entry of |out| (num_ref_idx_lX_active_minus1 + 1 entries) from
+// |refs|. Early in a GOP the parser leaves the entries past the available
+// references null; those repeat the last real reference, because the driver
+// checks every active index and the bitstream does not address them. Fails
+// if a reference is not in |dpb|, or if the first entry is null.
+bool FillH264RefList(base::span<const scoped_refptr<H264Picture>> dpb,
+                     const H264Picture::Vector& refs,
+                     base::span<v4l2_h264_reference> out);
+
+// Slice parameters and, when the PPS asks for weighted prediction for this
+// slice type, prediction weights (|pred_weights_required| is set then).
+// Reference lists name slots of |dpb|, which must be in the order of the DPB
+// array sent with the decode parameters.
+bool FillH264SliceParams(const H264PPS& pps,
+                         const H264SliceHeader& slice_hdr,
+                         base::span<const scoped_refptr<H264Picture>> dpb,
+                         const H264Picture::Vector& ref_pic_list0,
+                         const H264Picture::Vector& ref_pic_list1,
+                         v4l2_ctrl_h264_slice_params& slice,
+                         v4l2_ctrl_h264_pred_weights& weights,
+                         bool& pred_weights_required);
+
+}  // namespace media
+
+#endif  // MEDIA_GPU_V4L2_V4L2_H264_SLICE_H_
diff --git a/media/gpu/v4l2/v4l2_h264_slice_unittest.cc b/media/gpu/v4l2/v4l2_h264_slice_unittest.cc
new file mode 100644
index 00000000..0d806611
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_h264_slice_unittest.cc
@@ -0,0 +1,145 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/v4l2_h264_slice.h"
+
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "media/gpu/h264_dpb.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace media {
+namespace {
+
+scoped_refptr<H264Picture> MakePic(int frame_num) {
+  auto pic = base::MakeRefCounted<H264Picture>();
+  pic->frame_num = frame_num;
+  pic->pic_num = frame_num;
+  pic->ref = true;
+  pic->top_field_order_cnt = frame_num * 2;
+  pic->bottom_field_order_cnt = frame_num * 2;
+  return pic;
+}
+
+}  // namespace
+
+TEST(V4L2H264SliceTest, FrameBasedWheneverOffered) {
+  EXPECT_FALSE(
+      H264DecodeModeIsSliceBased(V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED));
+  EXPECT_TRUE(
+      H264DecodeModeIsSliceBased(V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED));
+
+  EXPECT_EQ(V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+            ChooseH264DecodeMode(V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED,
+                                 /*frame_based_offered=*/true));
+  EXPECT_EQ(V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+            ChooseH264DecodeMode(V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED,
+                                 /*frame_based_offered=*/true));
+  EXPECT_EQ(V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED,
+            ChooseH264DecodeMode(V4L2_STATELESS_H264_DECODE_MODE_SLICE_BASED,
+                                 /*frame_based_offered=*/false));
+}
+
+TEST(V4L2H264SliceTest, SliceForDriver) {
+  const uint8_t nal[] = {0x65, 0x88, 0x84, 0x00, 0x00};
+  // Annex-B keeps every byte behind a 3-byte start code.
+  EXPECT_EQ(
+      (std::vector<uint8_t>{0x00, 0x00, 0x01, 0x65, 0x88, 0x84, 0x00, 0x00}),
+      H264SliceForDriver(nal, V4L2_STATELESS_H264_START_CODE_ANNEX_B));
+  // A raw NAL loses the zero_byte of the next start code.
+  EXPECT_EQ((std::vector<uint8_t>{0x65, 0x88, 0x84}),
+            H264SliceForDriver(nal, V4L2_STATELESS_H264_START_CODE_NONE));
+
+  const uint8_t zeros[] = {0x00, 0x00};
+  EXPECT_TRUE(
+      H264SliceForDriver(zeros, V4L2_STATELESS_H264_START_CODE_NONE).empty());
+  EXPECT_TRUE(
+      H264SliceForDriver({}, V4L2_STATELESS_H264_START_CODE_ANNEX_B).empty());
+}
+
+TEST(V4L2H264SliceTest, RefListMapsSlotsAndRepeatsSpare) {
+  auto ref0 = MakePic(1);
+  auto ref1 = MakePic(2);
+  const std::vector<scoped_refptr<H264Picture>> dpb = {ref0, ref1};
+  v4l2_h264_reference out[4] = {};
+
+  // num_ref_idx_l0_active is 3, but only one reference exists so far.
+  ASSERT_TRUE(FillH264RefList(dpb, {ref1, nullptr, nullptr},
+                              base::span(out).first(3u)));
+  EXPECT_EQ(1u, out[0].index);
+  EXPECT_EQ(1u, out[1].index);
+  EXPECT_EQ(1u, out[2].index);
+  EXPECT_EQ(V4L2_H264_FRAME_REF, out[0].fields);
+  EXPECT_EQ(0u, out[3].fields);
+
+  // A reference that is not in the DPB, and an empty first entry, fail.
+  EXPECT_FALSE(FillH264RefList(dpb, {MakePic(9)}, base::span(out).first(1u)));
+  EXPECT_FALSE(
+      FillH264RefList(dpb, {nullptr, ref0}, base::span(out).first(2u)));
+}
+
+TEST(V4L2H264SliceTest, ISliceHasNoRefListAndPSliceDoes) {
+  auto ref = MakePic(4);
+  const std::vector<scoped_refptr<H264Picture>> dpb = {ref};
+  H264PPS pps;
+  H264SliceHeader i_slice;
+  i_slice.slice_type = H264SliceHeader::kISlice;
+  i_slice.header_bit_size = 40;
+  i_slice.first_mb_in_slice = 0;
+  i_slice.slice_qp_delta = 2;
+  v4l2_ctrl_h264_slice_params slice = {};
+  v4l2_ctrl_h264_pred_weights weights = {};
+  bool pred_weights = true;
+  ASSERT_TRUE(FillH264SliceParams(pps, i_slice, dpb, {}, {}, slice, weights,
+                                  pred_weights));
+  EXPECT_EQ(40u, slice.header_bit_size);
+  EXPECT_EQ(V4L2_H264_SLICE_TYPE_I, slice.slice_type);
+  EXPECT_EQ(2, slice.slice_qp_delta);
+  EXPECT_FALSE(pred_weights);
+  EXPECT_EQ(0u, slice.ref_pic_list0[0].fields);
+
+  H264SliceHeader p_slice;
+  p_slice.slice_type = H264SliceHeader::kPSlice;
+  p_slice.header_bit_size = 24;
+  p_slice.num_ref_idx_l0_active_minus1 = 0;
+  pred_weights = true;
+  ASSERT_TRUE(FillH264SliceParams(pps, p_slice, dpb, {ref}, {}, slice, weights,
+                                  pred_weights));
+  EXPECT_EQ(V4L2_H264_SLICE_TYPE_P, slice.slice_type);
+  EXPECT_EQ(0u, slice.ref_pic_list0[0].index);
+  EXPECT_EQ(V4L2_H264_FRAME_REF, slice.ref_pic_list0[0].fields);
+  EXPECT_FALSE(pred_weights);
+}
+
+TEST(V4L2H264SliceTest, WeightedPSliceFillsTheWeightTable) {
+  auto ref = MakePic(4);
+  const std::vector<scoped_refptr<H264Picture>> dpb = {ref};
+  H264PPS pps;
+  pps.weighted_pred_flag = true;
+  H264SliceHeader p_slice;
+  p_slice.slice_type = H264SliceHeader::kPSlice;
+  p_slice.header_bit_size = 24;
+  p_slice.num_ref_idx_l0_active_minus1 = 0;
+  p_slice.luma_log2_weight_denom = 6;
+  p_slice.chroma_log2_weight_denom = 5;
+  p_slice.pred_weight_table_l0.luma_weight[0] = 70;
+  p_slice.pred_weight_table_l0.luma_offset[0] = -3;
+  p_slice.pred_weight_table_l0.chroma_weight[0][1] = 30;
+  p_slice.pred_weight_table_l0.chroma_offset[0][1] = 4;
+  v4l2_ctrl_h264_slice_params slice = {};
+  v4l2_ctrl_h264_pred_weights weights = {};
+  bool pred_weights = false;
+  ASSERT_TRUE(FillH264SliceParams(pps, p_slice, dpb, {ref}, {}, slice, weights,
+                                  pred_weights));
+  EXPECT_TRUE(pred_weights);
+  EXPECT_EQ(6u, weights.luma_log2_weight_denom);
+  EXPECT_EQ(5u, weights.chroma_log2_weight_denom);
+  EXPECT_EQ(70, weights.weight_factors[0].luma_weight[0]);
+  EXPECT_EQ(-3, weights.weight_factors[0].luma_offset[0]);
+  EXPECT_EQ(30, weights.weight_factors[0].chroma_weight[0][1]);
+  EXPECT_EQ(4, weights.weight_factors[0].chroma_offset[0][1]);
