+bool V4L2StatelessVideoDecoderBackend::ReapCompletedInputBuffers() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!input_queue_) {
+    return false;
+  }
+  while (input_queue_->QueuedBuffersCount() > 0) {
+    auto dequeued = input_queue_->DequeueBuffer();
+    if (!dequeued.first) {
+      return false;
+    }
+    // EAGAIN: nothing else is ready. Dropping a dequeued buffer returns it
+    // to the free list.
+    if (!dequeued.second) {
+      break;
+    }
+  }
+  return true;
+}
+
+bool V4L2StatelessVideoDecoderBackend::SubmitHeldSlice(
+    V4L2DecodeSurface* dec_surface,
+    base::span<const uint8_t> slice,
+    bool queue_capture,
+    struct v4l2_ext_controls* ctrls) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!dec_surface || slice.empty() || !ctrls || !requests_queue_ ||
+      !input_queue_) {
+    return false;
+  }
+
+  // Running out of bitstream buffers or requests here is a decode error, not
+  // a stall: the slice cannot wait for a later Decode() call, because the
+  // CAPTURE buffer is already held for this picture.
+  if (!ReapCompletedInputBuffers()) {
+    client_->OnBackendError();
+    return false;
+  }
+  auto input_buf = input_queue_->GetFreeBuffer();
+  if (!input_buf) {
+    VLOGF(1) << "No free bitstream buffer for a held slice";
+    client_->OnBackendError();
+    return false;
+  }
+  std::optional<V4L2RequestRef> request = requests_queue_->GetFreeRequest();
+  if (!request) {
+    VLOGF(1) << "No free media request for a held slice";
+    client_->OnBackendError();
+    return false;
+  }
+
+  const size_t plane_size = input_buf->GetPlaneSize(0);
+  void* mapping = input_buf->GetPlaneMapping(0);
+  if (!mapping || slice.size() > plane_size) {
+    VLOGF(1) << "Held slice (" << slice.size()
+             << " bytes) does not fit the bitstream buffer (" << plane_size
+             << " bytes)";
+    client_->OnBackendError();
+    return false;
+  }
+  // SAFETY: GetPlaneMapping(0) maps the whole plane, GetPlaneSize(0) bytes.
+  UNSAFE_BUFFERS(base::span(static_cast<uint8_t*>(mapping), plane_size))
+      .copy_prefix_from(slice);
+  input_buf->SetPlaneBytesUsed(0, slice.size());
+  // Same timestamp as the picture's CAPTURE buffer, which every slice of the
+  // picture writes.
+  struct timeval timestamp = {.tv_sec = 0,
+                              .tv_usec = dec_surface->output_record()};
+  input_buf->SetTimeStamp(timestamp);
+  input_buf->SetFlags(V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF);
+
+  if (!request->ApplyCtrls(ctrls) ||
+      device_->Ioctl(VIDIOC_S_EXT_CTRLS, ctrls) != 0) {
+    VPLOGF(1) << "Failed to set the controls of a held slice";
+    client_->OnBackendError();
+    return false;
+  }
+
+  // Bitstream buffer, then the CAPTURE buffer (first slice only), then the
+  // request, the order libva-v4l2-request uses.
+  if (!std::move(*input_buf).QueueMMap(&(*request))) {
+    VLOGF(1) << "Failed to queue a held slice";
+    client_->OnBackendError();
+    return false;
+  }
+  if (queue_capture && !dec_surface->QueueCaptureBuffer()) {
+    VLOGF(1) << "Failed to queue the CAPTURE buffer with the first slice";
+    client_->OnBackendError();
+    return false;
+  }
+  std::optional<V4L2SubmittedRequestRef> submitted =
+      std::move(*request).Submit();
+  if (!submitted) {
+    VLOGF(1) << "Failed to submit the request of a held slice";
+    client_->OnBackendError();
+    return false;
+  }
+  // Block until the driver is done with this slice and returns its bitstream
+  // buffer, so the next slice can reuse one. When that happens depends on the
+  // driver: Apple AVD only copies the slice and completes at once, cedrus
+  // decodes it first. The CAPTURE buffer stays queued.
+  if (!submitted->WaitForCompletion(kHeldSliceTimeoutMs)) {
+    VLOGF(1) << "Held slice request timed out";
+    client_->OnBackendError();
+    return false;
+  }
+  if (!ReapCompletedInputBuffers()) {
+    client_->OnBackendError();
+    return false;
+  }
+  return true;
+}
