 namespace {
@@ -105,6 +123,61 @@ void QueryH264StatelessControls(V4L2Device* device,
            << " start_code=" << priv->start_code;
 }
 
+// The hold-capture flag is a property of the coded format, not of the device.
+// Call this after VIDIOC_S_FMT. A count of 0 only reports capabilities.
+void QueryHoldCapture(V4L2Device* device,
+                      V4L2VideoDecoderDelegateH264Private* priv) {
+  if (priv->hold_queried) {
+    return;
+  }
+  struct v4l2_create_buffers create = {};
+  create.count = 0;
+  create.memory = V4L2_MEMORY_MMAP;
+  create.format.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+  if (device->Ioctl(VIDIOC_CREATE_BUFS, &create) != 0) {
+    VPLOGF(1) << "VIDIOC_CREATE_BUFS capability query failed";
+    return;
+  }
+  priv->hold_queried = true;
+  priv->hold_capture =
+      (create.capabilities & V4L2_BUF_CAP_SUPPORTS_M2M_HOLD_CAPTURE_BUF) != 0;
+  VLOGF(1) << "H.264 hold_capture=" << priv->hold_capture
+           << " capabilities=" << create.capabilities;
+}
+
+void AppendExtCtrl(std::vector<struct v4l2_ext_control>& ctrls,
+                   __u32 id,
+                   void* ptr,
+                   __u32 size) {
+  struct v4l2_ext_control ctrl = {};
+  ctrl.id = id;
+  ctrl.ptr = ptr;
+  ctrl.size = size;
+  ctrls.push_back(ctrl);
+}
+
+// The controls of one held slice's request: SPS, PPS, scaling matrix and
+// decode parameters of the picture, the slice parameters, and prediction
+// weights when the slice uses them.
+void AppendHeldSliceControls(V4L2VideoDecoderDelegateH264Private& priv,
+                             PendingH264Slice& slice,
+                             std::vector<struct v4l2_ext_control>& ctrls) {
+  AppendExtCtrl(ctrls, V4L2_CID_STATELESS_H264_SPS, &priv.v4l2_sps,
+                sizeof(priv.v4l2_sps));
+  AppendExtCtrl(ctrls, V4L2_CID_STATELESS_H264_PPS, &priv.v4l2_pps,
+                sizeof(priv.v4l2_pps));
+  AppendExtCtrl(ctrls, V4L2_CID_STATELESS_H264_SCALING_MATRIX,
+                &priv.v4l2_scaling, sizeof(priv.v4l2_scaling));
+  AppendExtCtrl(ctrls, V4L2_CID_STATELESS_H264_DECODE_PARAMS,
+                &priv.v4l2_decode_param, sizeof(priv.v4l2_decode_param));
+  AppendExtCtrl(ctrls, V4L2_CID_STATELESS_H264_SLICE_PARAMS, &slice.params,
+                sizeof(slice.params));
+  if (slice.pred_weights_required) {
+    AppendExtCtrl(ctrls, V4L2_CID_STATELESS_H264_PRED_WEIGHTS, &slice.weights,
+                  sizeof(slice.weights));
+  }
+}
