diff --git a/media/gpu/v4l2/v4l2_hevc_slice.cc b/media/gpu/v4l2/v4l2_hevc_slice.cc
new file mode 100644
index 00000000..0a05fa7c
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_hevc_slice.cc
@@ -0,0 +1,231 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/v4l2_hevc_slice.h"
+
+#include <algorithm>
+#include <iterator>
+
+#include "base/logging.h"
+#include "base/numerics/safe_conversions.h"
+#include "media/gpu/macros.h"
+
+namespace media {
+
+namespace {
+
+int FindHevcDpbIndex(base::span<const scoped_refptr<H265Picture>> dpb,
+                     const H265Picture* pic) {
+  for (size_t i = 0; i < dpb.size(); ++i) {
+    if (dpb[i].get() == pic) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+// Fills one reference index per entry of |out|.
+bool FillHevcRefIdx(base::span<const scoped_refptr<H265Picture>> dpb,
+                    const H265Picture::Vector& refs,
+                    base::span<__u8> out) {
+  if (out.size() > refs.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < out.size(); ++i) {
+    const int index = refs[i] ? FindHevcDpbIndex(dpb, refs[i].get()) : -1;
+    if (index < 0) {
+      return false;
+    }
+    out[i] = static_cast<__u8>(index);
+  }
+  return true;
+}
+
+// The chroma offset the hardware applies, derived from the coded delta as in
+// H.265 equation 7-56. The uAPI field carries this value, not the delta.
+int HevcChromaOffset(const H265SPS& sps,
+                     int chroma_log2_weight_denom,
+                     int delta_chroma_weight,
+                     int delta_chroma_offset) {
+  const int half = sps.wp_offset_half_range_c;
+  const int chroma_weight =
+      (1 << chroma_log2_weight_denom) + delta_chroma_weight;
+  return std::clamp(half + delta_chroma_offset -
+                        ((half * chroma_weight) >> chroma_log2_weight_denom),
+                    -half, half - 1);
+}
+
+bool FillHevcWeights(const H265SPS& sps,
+                     const H265PredWeightTable& table,
+                     base::span<const int> delta_luma_weight,
+                     base::span<const int> luma_offset,
+                     base::span<const std::array<int, 2>> delta_chroma_weight,
+                     base::span<const std::array<int, 2>> delta_chroma_offset,
+                     base::span<__s8> out_delta_luma_weight,
+                     base::span<__s8> out_luma_offset,
+                     base::span<__s8[2]> out_delta_chroma_weight,
+                     base::span<__s8[2]> out_chroma_offset,
+                     size_t count) {
+  for (size_t i = 0; i < count; ++i) {
+    if (!base::IsValueInRangeForNumericType<__s8>(luma_offset[i])) {
+      return false;
+    }
+    out_delta_luma_weight[i] = base::checked_cast<__s8>(delta_luma_weight[i]);
+    out_luma_offset[i] = static_cast<__s8>(luma_offset[i]);
+    for (size_t j = 0; j < 2; ++j) {
+      const int offset = HevcChromaOffset(sps, table.chroma_log2_weight_denom,
+                                          delta_chroma_weight[i][j],
+                                          delta_chroma_offset[i][j]);
+      if (!base::IsValueInRangeForNumericType<__s8>(offset)) {
+        return false;
+      }
+      out_delta_chroma_weight[i][j] =
+          base::checked_cast<__s8>(delta_chroma_weight[i][j]);
+      out_chroma_offset[i][j] = static_cast<__s8>(offset);
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+std::vector<uint8_t> HevcSliceForDriver(base::span<const uint8_t> nal,
+                                        int32_t start_code) {
+  if (start_code == V4L2_STATELESS_HEVC_START_CODE_NONE) {
+    while (!nal.empty() && nal.back() == 0x00) {
+      nal = nal.first(nal.size() - 1);
+    }
+    return std::vector<uint8_t>(nal.begin(), nal.end());
+  }
+  if (nal.empty()) {
+    return {};
+  }
+  std::vector<uint8_t> bytes = {0x00, 0x00, 0x01};
+  bytes.insert(bytes.end(), nal.begin(), nal.end());
+  return bytes;
+}
+
+bool FillHevcSliceParams(const H265SPS& sps,
+                         const H265SliceHeader& slice_hdr,
+                         base::span<const scoped_refptr<H265Picture>> dpb,
+                         const H265Picture::Vector& ref_pic_list0,
+                         const H265Picture::Vector& ref_pic_list1,
+                         int pic_order_cnt,
+                         size_t slice_size,
+                         size_t prefix,
+                         v4l2_ctrl_hevc_slice_params& out) {
+  // header_size excludes emulation-prevention bytes. The hardware is pointed
+  // at a byte of the submitted buffer, so the offset must count them.
+  const size_t header_raw =
+      slice_hdr.header_size + slice_hdr.header_emulation_prevention_bytes;
+  if (prefix > slice_size || header_raw > slice_size - prefix) {
+    VLOGF(1) << "HEVC slice header extends past the NAL";
+    return false;
+  }
+
+  out = {};
+  out.bit_size = base::checked_cast<__u32>(slice_size * 8);
+  out.data_byte_offset = base::checked_cast<__u32>(header_raw + prefix);
+  out.num_entry_point_offsets = 0;
+  out.nal_unit_type = static_cast<__u8>(slice_hdr.nal_unit_type);
+  out.nuh_temporal_id_plus1 = static_cast<__u8>(slice_hdr.temporal_id + 1);
+  out.slice_type = static_cast<__u8>(slice_hdr.slice_type);
+  out.colour_plane_id = static_cast<__u8>(slice_hdr.colour_plane_id);
+  out.slice_pic_order_cnt = pic_order_cnt;
+  out.num_ref_idx_l0_active_minus1 =
+      static_cast<__u8>(slice_hdr.num_ref_idx_l0_active_minus1);
+  out.num_ref_idx_l1_active_minus1 =
+      static_cast<__u8>(slice_hdr.num_ref_idx_l1_active_minus1);
+  out.collocated_ref_idx = slice_hdr.slice_temporal_mvp_enabled_flag
+                               ? static_cast<__u8>(slice_hdr.collocated_ref_idx)
+                               : 0;
+  out.five_minus_max_num_merge_cand =
+      static_cast<__u8>(slice_hdr.five_minus_max_num_merge_cand);
+  out.slice_qp_delta = static_cast<__s8>(slice_hdr.slice_qp_delta);
+  out.slice_cb_qp_offset = static_cast<__s8>(slice_hdr.slice_cb_qp_offset);
+  out.slice_cr_qp_offset = static_cast<__s8>(slice_hdr.slice_cr_qp_offset);
+  out.slice_beta_offset_div2 =
+      static_cast<__s8>(slice_hdr.slice_beta_offset_div2);
+  out.slice_tc_offset_div2 = static_cast<__s8>(slice_hdr.slice_tc_offset_div2);
+  out.slice_segment_addr = static_cast<__u32>(slice_hdr.slice_segment_address);
+  out.short_term_ref_pic_set_size = static_cast<__u16>(slice_hdr.st_rps_bits);
+  out.long_term_ref_pic_set_size = static_cast<__u16>(slice_hdr.lt_rps_bits);
+
+  if (slice_hdr.slice_sao_luma_flag) {
+    out.flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_LUMA;
+  }
+  if (slice_hdr.slice_sao_chroma_flag) {
+    out.flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_CHROMA;
+  }
+  if (slice_hdr.slice_temporal_mvp_enabled_flag) {
+    out.flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_TEMPORAL_MVP_ENABLED;
+  }
+  if (slice_hdr.mvd_l1_zero_flag) {
+    out.flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_MVD_L1_ZERO;
+  }
+  if (slice_hdr.cabac_init_flag) {
+    out.flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_CABAC_INIT;
+  }
+  if (slice_hdr.collocated_from_l0_flag) {
+    out.flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_COLLOCATED_FROM_L0;
+  }
+  if (slice_hdr.slice_deblocking_filter_disabled_flag) {
+    out.flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_DEBLOCKING_FILTER_DISABLED;
+  }
+  if (slice_hdr.slice_loop_filter_across_slices_enabled_flag) {
+    out.flags |=
+        V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_LOOP_FILTER_ACROSS_SLICES_ENABLED;
+  }
+  if (slice_hdr.dependent_slice_segment_flag) {
+    out.flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_DEPENDENT_SLICE_SEGMENT;
+  }
+
+  // The parser keeps at most kMaxRefIdxActive (15) entries per list. The
+  // V4L2 arrays have V4L2_HEVC_DPB_ENTRIES_NUM_MAX (16).
+  const size_t n0 = std::min<size_t>(slice_hdr.num_ref_idx_l0_active_minus1 + 1,
+                                     kMaxRefIdxActive);
+  const size_t n1 = std::min<size_t>(slice_hdr.num_ref_idx_l1_active_minus1 + 1,
+                                     kMaxRefIdxActive);
+  const bool is_p_or_b = slice_hdr.IsPSlice() || slice_hdr.IsBSlice();
+  if (is_p_or_b && !FillHevcRefIdx(dpb, ref_pic_list0,
+                                   base::span(out.ref_idx_l0).first(n0))) {
+    VLOGF(1) << "HEVC L0 reference is not in the DPB";
+    return false;
+  }
+  if (slice_hdr.IsBSlice() &&
+      !FillHevcRefIdx(dpb, ref_pic_list1,
+                      base::span(out.ref_idx_l1).first(n1))) {
+    VLOGF(1) << "HEVC L1 reference is not in the DPB";
+    return false;
+  }
+  if (!is_p_or_b) {
+    return true;
+  }
+
+  const H265PredWeightTable& table = slice_hdr.pred_weight_table;
+  v4l2_hevc_pred_weight_table& pred = out.pred_weight_table;
+  pred.luma_log2_weight_denom = static_cast<__u8>(table.luma_log2_weight_denom);
+  pred.delta_chroma_log2_weight_denom =
+      static_cast<__s8>(table.delta_chroma_log2_weight_denom);
+  if (!FillHevcWeights(sps, table, table.delta_luma_weight_l0,
+                       table.luma_offset_l0, table.delta_chroma_weight_l0,
+                       table.delta_chroma_offset_l0, pred.delta_luma_weight_l0,
+                       pred.luma_offset_l0, pred.delta_chroma_weight_l0,
+                       pred.chroma_offset_l0, n0)) {
+    VLOGF(1) << "HEVC L0 prediction weight offset out of range";
+    return false;
+  }
+  if (slice_hdr.IsBSlice() &&
+      !FillHevcWeights(sps, table, table.delta_luma_weight_l1,
+                       table.luma_offset_l1, table.delta_chroma_weight_l1,
+                       table.delta_chroma_offset_l1, pred.delta_luma_weight_l1,
+                       pred.luma_offset_l1, pred.delta_chroma_weight_l1,
+                       pred.chroma_offset_l1, n1)) {
+    VLOGF(1) << "HEVC L1 prediction weight offset out of range";
+    return false;
+  }
+  return true;
+}
+
+}  // namespace media
diff --git a/media/gpu/v4l2/v4l2_hevc_slice.h b/media/gpu/v4l2/v4l2_hevc_slice.h
