+++ b/media/gpu/v4l2/v4l2_hevc_slice.h
@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_GPU_V4L2_V4L2_HEVC_SLICE_H_
+#define MEDIA_GPU_V4L2_V4L2_HEVC_SLICE_H_
+
+#include <linux/v4l2-controls.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "media/gpu/h265_dpb.h"
+#include "media/parsers/h265_parser.h"
+
+namespace media {
+
+// The bytes to submit for one slice NAL: with a 3-byte start code for
+// V4L2_STATELESS_HEVC_START_CODE_ANNEX_B, or the NAL without its trailing
+// zero bytes for V4L2_STATELESS_HEVC_START_CODE_NONE. Empty if nothing is left.
+std::vector<uint8_t> HevcSliceForDriver(base::span<const uint8_t> nal,
+                                        int32_t start_code);
+
+// Fills the slice parameters of one slice. |slice_size| is the number of bytes
+// submitted for the slice, including |prefix| start-code bytes. Reference
+// indices name slots of |dpb|, which is in the order of the DPB sent with the
+// decode parameters. Fails when a reference is not in |dpb|, and when a
+// prediction-weight offset does not fit the uAPI's 8-bit fields.
+//
+// num_entry_point_offsets is always 0: the parser does not keep the offsets.
+bool FillHevcSliceParams(const H265SPS& sps,
+                         const H265SliceHeader& slice_hdr,
+                         base::span<const scoped_refptr<H265Picture>> dpb,
+                         const H265Picture::Vector& ref_pic_list0,
+                         const H265Picture::Vector& ref_pic_list1,
+                         int pic_order_cnt,
+                         size_t slice_size,
+                         size_t prefix,
+                         v4l2_ctrl_hevc_slice_params& out);
+
+}  // namespace media
+
+#endif  // MEDIA_GPU_V4L2_V4L2_HEVC_SLICE_H_
diff --git a/media/gpu/v4l2/v4l2_hevc_slice_unittest.cc b/media/gpu/v4l2/v4l2_hevc_slice_unittest.cc
new file mode 100644
index 00000000..e4a530f0
--- /dev/null
+++ b/media/gpu/v4l2/v4l2_hevc_slice_unittest.cc
@@ -0,0 +1,147 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/v4l2_hevc_slice.h"
+
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace media {
+namespace {
+
+scoped_refptr<H265Picture> MakePic(int poc) {
+  auto pic = base::MakeRefCounted<H265Picture>();
+  pic->pic_order_cnt_val_ = poc;
+  pic->ref_ = H265Picture::kShortTermCurrBefore;
+  return pic;
+}
+
+// 8-bit SPS without high-precision offsets.
+H265SPS MakeSps() {
+  H265SPS sps;
+  sps.wp_offset_half_range_y = 128;
+  sps.wp_offset_half_range_c = 128;
+  return sps;
+}
+
+}  // namespace
+
+TEST(V4L2HevcSliceTest, SliceForDriver) {
+  const uint8_t nal[] = {0x26, 0x01, 0xaf, 0x00, 0x00};
+  EXPECT_EQ(
+      std::vector<uint8_t>({0x00, 0x00, 0x01, 0x26, 0x01, 0xaf, 0x00, 0x00}),
+      HevcSliceForDriver(nal, V4L2_STATELESS_HEVC_START_CODE_ANNEX_B));
+  EXPECT_EQ(std::vector<uint8_t>({0x26, 0x01, 0xaf}),
+            HevcSliceForDriver(nal, V4L2_STATELESS_HEVC_START_CODE_NONE));
+}
+
+TEST(V4L2HevcSliceTest, ISliceParamsPointPastTheHeader) {
+  H265SliceHeader slice_hdr;
+  slice_hdr.nal_unit_type = 19;  // IDR_W_RADL
+  slice_hdr.slice_type = H265SliceHeader::kSliceTypeI;
+  slice_hdr.header_size = 12;
+  slice_hdr.header_emulation_prevention_bytes = 1;
+  slice_hdr.slice_qp_delta = -3;
+  slice_hdr.slice_sao_luma_flag = true;
+  slice_hdr.slice_sao_chroma_flag = true;
+  slice_hdr.temporal_id = 0;
+
+  v4l2_ctrl_hevc_slice_params params = {};
+  ASSERT_TRUE(FillHevcSliceParams(MakeSps(), slice_hdr, {}, {}, {},
+                                  /*pic_order_cnt=*/8, /*slice_size=*/40,
+                                  /*prefix=*/0, params));
+  EXPECT_EQ(40u * 8, params.bit_size);
+  // 12 RBSP bytes plus the one emulation-prevention byte, and no start code.
+  EXPECT_EQ(13u, params.data_byte_offset);
+  EXPECT_EQ(8, params.slice_pic_order_cnt);
+  EXPECT_EQ(V4L2_HEVC_SLICE_TYPE_I, params.slice_type);
+  EXPECT_EQ(-3, params.slice_qp_delta);
+  EXPECT_EQ(1u, params.nuh_temporal_id_plus1);
+  EXPECT_TRUE(params.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_LUMA);
+  EXPECT_TRUE(params.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_CHROMA);
+
+  // A header that runs past the submitted NAL is rejected.
+  EXPECT_FALSE(FillHevcSliceParams(MakeSps(), slice_hdr, {}, {}, {}, 8,
+                                   /*slice_size=*/4, /*prefix=*/0, params));
+}
+
+TEST(V4L2HevcSliceTest, PSliceNamesTheDpbSlot) {
+  auto other = MakePic(2);
+  auto ref = MakePic(4);
+  const std::vector<scoped_refptr<H265Picture>> dpb = {other, ref};
+  H265Picture::Vector refs = {ref};
+
+  H265SliceHeader slice_hdr;
+  slice_hdr.slice_type = H265SliceHeader::kSliceTypeP;
+  slice_hdr.header_size = 8;
+  slice_hdr.num_ref_idx_l0_active_minus1 = 0;
+  slice_hdr.pred_weight_table.luma_log2_weight_denom = 5;
+  slice_hdr.pred_weight_table.delta_luma_weight_l0[0] = 2;
+
+  v4l2_ctrl_hevc_slice_params params = {};
+  ASSERT_TRUE(FillHevcSliceParams(MakeSps(), slice_hdr, dpb, refs, {},
+                                  /*pic_order_cnt=*/6, /*slice_size=*/23,
+                                  /*prefix=*/3, params));
+  EXPECT_EQ(V4L2_HEVC_SLICE_TYPE_P, params.slice_type);
+  EXPECT_EQ(1u, params.ref_idx_l0[0]);
+  EXPECT_EQ(23u * 8, params.bit_size);
+  EXPECT_EQ(11u, params.data_byte_offset);
+  EXPECT_EQ(5u, params.pred_weight_table.luma_log2_weight_denom);
+  EXPECT_EQ(2, params.pred_weight_table.delta_luma_weight_l0[0]);
+  // No chroma weighting: the derived chroma offsets are 0.
+  EXPECT_EQ(0, params.pred_weight_table.chroma_offset_l0[0][0]);
+  EXPECT_EQ(0, params.pred_weight_table.chroma_offset_l0[0][1]);
+
+  // A reference that is not in the DPB fails the slice.
+  H265Picture::Vector missing = {MakePic(99)};
+  EXPECT_FALSE(FillHevcSliceParams(MakeSps(), slice_hdr, dpb, missing, {}, 6,
+                                   23, 3, params));
+}
+
+TEST(V4L2HevcSliceTest, ChromaOffsetIsDerivedFromTheWeight) {
+  auto ref = MakePic(4);
+  const std::vector<scoped_refptr<H265Picture>> dpb = {ref};
+  H265Picture::Vector refs = {ref};
+
+  H265SliceHeader slice_hdr;
+  slice_hdr.slice_type = H265SliceHeader::kSliceTypeP;
+  slice_hdr.header_size = 8;
+  slice_hdr.num_ref_idx_l0_active_minus1 = 0;
+  H265PredWeightTable& table = slice_hdr.pred_weight_table;
+  table.luma_log2_weight_denom = 6;
+  table.delta_chroma_log2_weight_denom = 0;
+  table.chroma_log2_weight_denom = 6;
+  // ChromaWeight = 64 + 10 = 74: 128 + 30 - ((128 * 74) >> 6) = 10.
+  table.delta_chroma_weight_l0[0][0] = 10;
+  table.delta_chroma_offset_l0[0][0] = 30;
+  // ChromaWeight = 64 - 32 = 32: 128 - 40 - ((128 * 32) >> 6) = 24.
+  table.delta_chroma_weight_l0[0][1] = -32;
+  table.delta_chroma_offset_l0[0][1] = -40;
+
+  v4l2_ctrl_hevc_slice_params params = {};
+  ASSERT_TRUE(FillHevcSliceParams(MakeSps(), slice_hdr, dpb, refs, {}, 6, 20, 0,
+                                  params));
+  EXPECT_EQ(10, params.pred_weight_table.delta_chroma_weight_l0[0][0]);
+  EXPECT_EQ(10, params.pred_weight_table.chroma_offset_l0[0][0]);
+  EXPECT_EQ(-32, params.pred_weight_table.delta_chroma_weight_l0[0][1]);
+  EXPECT_EQ(24, params.pred_weight_table.chroma_offset_l0[0][1]);
+
+  // Clipped to [-128, 127].
+  table.delta_chroma_weight_l0[0][0] = 0;
+  table.delta_chroma_offset_l0[0][0] = 511;
+  ASSERT_TRUE(FillHevcSliceParams(MakeSps(), slice_hdr, dpb, refs, {}, 6, 20, 0,
+                                  params));
+  EXPECT_EQ(127, params.pred_weight_table.chroma_offset_l0[0][0]);
+
+  // With high-precision offsets the derived value can exceed the 8-bit field.
+  H265SPS high_precision = MakeSps();
+  high_precision.wp_offset_half_range_c = 512;
+  table.delta_chroma_offset_l0[0][0] = 200;
+  EXPECT_FALSE(FillHevcSliceParams(high_precision, slice_hdr, dpb, refs, {}, 6,
+                                   20, 0, params));
+}
