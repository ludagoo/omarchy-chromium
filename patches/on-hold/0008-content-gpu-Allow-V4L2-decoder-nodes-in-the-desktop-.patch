diff --git a/content/common/gpu_pre_sandbox_hook_linux.cc b/content/common/gpu_pre_sandbox_hook_linux.cc
index 149b8dc9..6dfd9fd7 100644
--- a/content/common/gpu_pre_sandbox_hook_linux.cc
+++ b/content/common/gpu_pre_sandbox_hook_linux.cc
@@ -38,6 +38,8 @@
 #include "sandbox/policy/linux/sandbox_linux.h"
 
 #if BUILDFLAG(USE_V4L2_CODEC)
+#include "media/base/decoder.h"
+#include "media/gpu/v4l2/v4l2_decoder_nodes.h"
 #include "media/gpu/v4l2/v4l2_device.h"
 #endif
 
@@ -191,6 +193,29 @@ void AddV4L2GpuPermissions(
   }
 }
 
+// Desktop Linux. The kernel names V4L2 decoders /dev/videoN and /dev/mediaN,
+// the same names as cameras, and no udev rule gives them the ChromeOS names.
+// Unlike AddV4L2GpuPermissions(), this uses a FileEnumerator: the decoder
+// nodes are found by asking each node what it is, before the sandbox starts.
+// Only memory-to-memory decoder nodes and their media controllers are
+// allowed, never a camera. A decoder that appears after the GPU process
+// starts is not allowed until the GPU process restarts.
+void AddLinuxV4L2DecoderPermissions(
+    std::vector<BrokerFilePermission>* permissions,
+    const sandbox::policy::SandboxSeccompBPF::Options& options) {
+#if BUILDFLAG(USE_V4L2_CODEC)
+  // The scan opens every /dev/videoN, cameras included, so it runs only when
+  // V4L2 is the decoder this GPU process will use.
+  if (!options.accelerated_video_decode_enabled ||
+      media::ActiveLinuxVideoDecoderType() != media::VideoDecoderType::kV4L2) {
+    return;
+  }
+  for (const std::string& path : media::FindV4L2DecoderDevicePaths()) {
+    permissions->push_back(BrokerFilePermission::ReadWrite(path));
+  }
+#endif
+}
+
 void AddArmMaliGpuPermissions(std::vector<BrokerFilePermission>* permissions) {
   // Device file needed by the ARM GPU userspace.
   static const char kMali0Path[] = "/dev/mali0";
@@ -674,6 +699,8 @@ std::vector<BrokerFilePermission> FilePermissionsForGpu(
       AddChromecastArmGpuPermissions(&permissions);
       return permissions;
     }
+  } else {
+    AddLinuxV4L2DecoderPermissions(&permissions, options);
   }
 
   AddStandardGpuPermissions(&permissions);
